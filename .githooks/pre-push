#!/usr/bin/env bash
set -euo pipefail

# Git pre-push hook input format per line:
# <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# 目标：当本次 push 包含 tag（refs/tags/*）时，自动执行本地打包脚本。

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${REPO_ROOT}" ]]; then
  # 兜底：当脚本被复制到 .git/hooks 下时，仓库根目录应为其上两级
  REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi
PACKAGE_SCRIPT="${REPO_ROOT}/scripts/02-package.sh"

need_package="0"
while read -r local_ref _local_sha remote_ref _remote_sha; do
  if [[ "${local_ref}" == refs/tags/* ]] || [[ "${remote_ref}" == refs/tags/* ]]; then
    need_package="1"
    break
  fi
done

if [[ "${need_package}" != "1" ]]; then
  exit 0
fi

if [[ "${LOCAL_TAG_PACKAGE:-0}" != "1" ]]; then
  echo "[pre-push] detected tag push."
  echo "[pre-push] local packaging disabled by default; CI (.gitlab-ci.yml) will package on tag."
  echo "[pre-push] set LOCAL_TAG_PACKAGE=1 if you want local package before push."
  exit 0
fi

if [[ ! -x "${PACKAGE_SCRIPT}" ]]; then
  echo "[pre-push] package script not executable: ${PACKAGE_SCRIPT}"
  echo "[pre-push] run: chmod +x ./02-package.sh"
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "[pre-push] npm not found, cannot run local package with LOCAL_TAG_PACKAGE=1."
  exit 1
fi

echo "[pre-push] detected tag push, running local package script..."
bash "${PACKAGE_SCRIPT}"
echo "[pre-push] local package completed."
