DINGTALK_APPKEY=YOUR_CLIENT_ID
DINGTALK_APPSECRET=YOUR_CLIENT_SECRET
TB_TOOL_BT_DEBUG=false

# 数据库：默认 SQLite；使用本地 MySQL 时取消下面注释并填写账号
# TB_TOOL_BT_USE_MYSQL=1
# TB_TOOL_BT_DB_HOST=127.0.0.1
# TB_TOOL_BT_DB_PORT=3306
# TB_TOOL_BT_DB_USER=root
# TB_TOOL_BT_DB_PASSWORD=your_password
# TB_TOOL_BT_DB_NAME=tb_tool_bt
# 或整条 URI 覆盖（优先级高于 USE_MYSQL）：
# TB_TOOL_BT_DATABASE_URI=mysql+pymysql://root:pass@127.0.0.1:3306/tb_tool_bt?charset=utf8mb4
#
# 仍兼容旧变量名 TB_TOOL_B1_*（不推荐新环境使用）
