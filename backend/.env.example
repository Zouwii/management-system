DINGTALK_APPKEY=YOUR_CLIENT_ID
DINGTALK_APPSECRET=YOUR_CLIENT_SECRET
DINGTALK_REDIRECT_URI=http://localhost:5001/api/bt/auth/callback
SECRET_KEY=replace-this-in-production
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_EXPIRE_SECONDS=86400
# 多个前端域名用逗号分隔；同域部署可保持 *
CORS_ORIGINS=*
TB_TOOL_BT_DEBUG=false

# RAG Markdown 下载（必填：钉钉 MCP JSON-RPC 地址，包含访问 key）
DINGTALK_KB_MCP_URL=https://mcp-gw.dingtalk.com/server/REPLACE_ME?key=REPLACE_ME
# DINGTALK_KB_MCP_WORKERS=8
# DINGTALK_KB_MCP_TIMEOUT=60
# 自动切分与向量化暂时默认关闭；Markdown 回填稳定后再设为 true
KB_AUTO_CHUNK_EMBED_ENABLED=false

# 数据库：默认 SQLite；使用本地 MySQL 时取消下面注释并填写账号
# TB_TOOL_BT_USE_MYSQL=1
# TB_TOOL_BT_DB_HOST=127.0.0.1
# TB_TOOL_BT_DB_PORT=3306
# TB_TOOL_BT_DB_USER=root
# TB_TOOL_BT_DB_PASSWORD=your_password
# TB_TOOL_BT_DB_NAME=benti_management
# 或整条 URI 覆盖（优先级高于 USE_MYSQL）：
# TB_TOOL_BT_DATABASE_URI=mysql+pymysql://root:pass@127.0.0.1:3306/tb_tool_bt?charset=utf8mb4
#
# 知识库专用数据库（kb_documents / kb_chunks，默认 kb_storage）
# TB_TOOL_BT_KB_DB_NAME=kb_storage
# 或整条 URI 覆盖：
# TB_TOOL_BT_KB_DATABASE_URI=mysql+pymysql://root:pass@127.0.0.1:3306/kb_storage?charset=utf8mb4
#
# 绩效专用数据库（默认 perf_quarter_result）
# TB_TOOL_BT_PERF_DB_NAME=perf_quarter_result
#
# 算法组四张 A/B 表专用数据库（默认 algo_management）
# TB_TOOL_BT_ALGO_DB_NAME=algo_management
# 或整条 URI 覆盖：
# TB_TOOL_BT_ALGO_DATABASE_URI=mysql+pymysql://root:pass@127.0.0.1:3306/algo_management?charset=utf8mb4
#
# 仍兼容旧变量名 TB_TOOL_B1_*（不推荐新环境使用）
